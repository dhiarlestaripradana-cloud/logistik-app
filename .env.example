# ========= DATABASE (PostgreSQL 16) =========
POSTGRES_USER=logistik
POSTGRES_PASSWORD=ganti_dengan_password_kuat_disini
POSTGRES_DB=logistik_db

# URL untuk Prisma. Saat DEV di laptop (db diekspos ke localhost:5432):
#   postgresql://logistik:password@localhost:5432/logistik_db?schema=public
# Saat PRODUKSI di dalam docker-compose, host = nama service 'db':
DATABASE_URL="postgresql://logistik:ganti_dengan_password_kuat_disini@db:5432/logistik_db?schema=public"

# ========= AUTH.JS v5 =========
# Generate dengan: npx auth secret   (atau: openssl rand -base64 32)
AUTH_SECRET="isi_dengan_hasil_generate_secret"
AUTH_TRUST_HOST=true

# ========= APLIKASI =========
APP_URL="https://logistik.perusahaan.co.id"
APP_DOMAIN="logistik.perusahaan.co.id"

# ========= SEED SUPER ADMIN PERDANA =========
SEED_ADMIN_NAMA="Administrator Utama"
SEED_ADMIN_USERNAME="superadmin"
SEED_ADMIN_PASSWORD="ganti_password_admin_perdana"

# ========= IDENTITAS PERUSAHAAN (KOP SURAT PDF) =========
COMPANY_NAME="PT LOGISTIK MAJU BERSAMA"
COMPANY_ADDRESS="Jl. Raya Industri No. 88, Cikarang, Kab. Bekasi, Jawa Barat"
COMPANY_PHONE="Telp: (021) 8990-1234 · WA: 0812-3456-7890"

